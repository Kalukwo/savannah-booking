# Copy to .env and set real values. .env is gitignored and never committed.
#
# Used by docker compose for local dev: compose substitutes ${POSTGRES_*}
# into both the db service and the app's DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=appointments

# Integration tests only. NEVER point at the real database.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:change-me-in-local-env@localhost:5433/appointments_test

# NOTE: in production (Render + Neon) do NOT use this file.
# Set DATABASE_URL directly in Render's dashboard environment variables,
# pasting Neon's connection string verbatim. app/core/config.py rewrites
# postgres:// and postgresql:// to postgresql+asyncpg:// and sslmode= to ssl=.
